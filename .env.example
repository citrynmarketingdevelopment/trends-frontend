# Public browser-safe configuration. Production requires a bare HTTPS origin.
# Local development may use http://localhost:3000.
NEXT_PUBLIC_SITE_ORIGIN=
NEXT_PUBLIC_ANALYTICS_ID=

# Server-only integration configuration
BACKEND_API_ORIGIN=
PORTAL_EXCHANGE_SECRET=
OBSERVABILITY_DSN=

# Contact form SMTP (server only). Both recipient and sender must be configured.
# 587 uses required STARTTLS; 465 uses TLS from connection start.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
