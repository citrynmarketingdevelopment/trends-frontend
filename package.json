{
  "name": "trends-collision-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.33.2 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "api:generate": "openapi-typescript contracts/openapi.json -o src/contracts/backend.generated.ts",
    "assets:logo": "powershell -ExecutionPolicy Bypass -File scripts/assets/build_trends_logo.ps1",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.7.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "motion": "^13.1.0",
    "next": "^16.3.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@gltf-transform/cli": "4.4.2",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/addon-vitest": "10.5.8",
    "@storybook/nextjs-vite": "10.5.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "sharp": "0.34.5",
    "storybook": "10.5.8",
    "typescript": "~5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
