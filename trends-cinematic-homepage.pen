                  "id": "K4Au5B",
                  "name": "Question",
                  "fill": "$bone",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Can you recover the car tonight?",
                  "lineHeight": 1.12,
                  "fontFamily": "$font-display",
                  "fontSize": 28,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "PrhcD",
                  "name": "Answer",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Yes. Roadside dispatch runs around the clock and the tow comes straight to our floor.",
                  "lineHeight": 1.85,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
