                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "What happens during a collision repair inspection?",
                          "lineHeight": 1.35,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "zdJ2b",
                          "name": "A",
                          "fill": "$ink-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The vehicle is inspected in person, photographed, and where necessary partially disassembled so damage behind the panel is found before the plan is written.",
                          "lineHeight": 1.7,
                          "fontFamily": "$font-body",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
