              "name": "D",
              "fill": "#F2EEE6BB",
              "textGrowth": "fixed-width",
              "width": 640,
              "content": "Every repair is measured, refinished, and reviewed against one documented standard before a customer is called.",
              "lineHeight": 1.6,
              "textAlign": "center",
              "fontFamily": "$font-body",
              "fontSize": 15,
              "fontWeight": "normal"
