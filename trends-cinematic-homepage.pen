                  "id": "TcIQh",
                  "name": "H",
                  "fill": "$bone",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Structure first. Then the surface.",
                  "lineHeight": 0.92,
                  "fontFamily": "$font-display",
                  "fontSize": 46,
                  "fontWeight": "800",
                  "letterSpacing": -1
                },
                {
                  "type": "frame",
