                  "fill": "$bone",
                  "textGrowth": "fixed-width",
                  "width": 420,
                  "content": "What happens during a collision repair inspection?",
                  "lineHeight": 1.35,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "kv7Uv",
                  "name": "A",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The vehicle is inspected in person, photographed, and where necessary partially disassembled so damage behind the panel is found before a plan is written.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
