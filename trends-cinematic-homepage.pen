                  "id": "i8HUT2",
                  "name": "Question",
                  "fill": "$bone",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Will the paint match?",
                  "lineHeight": 1.12,
                  "fontFamily": "$font-display",
                  "fontSize": 28,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "V59RCK",
                  "name": "Answer",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Colour is mixed to the VIN code, then adjusted against your panel under shop light before anything is sprayed.",
                  "lineHeight": 1.85,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "rWKvH",
              "name": "Q",
