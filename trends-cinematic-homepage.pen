                  "fill": "$bone",
                  "textGrowth": "fixed-width",
                  "width": 420,
                  "content": "How long will my repair take?",
                  "lineHeight": 1.35,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "g5bTmW",
                  "name": "A",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "It depends on damage, parts availability, and insurer approvals. You get a realistic estimate after inspection and an update if it changes.",
