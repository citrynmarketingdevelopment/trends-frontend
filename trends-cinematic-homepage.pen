              "padding": [
                30,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "F2SP7t",
                  "name": "Question",
                  "fill": "#141112",
                  "textGrowth": "fixed-width",
                  "width": 470,
                  "content": "Do I have to use the shop my insurer names?",
                  "lineHeight": 1.25,
                  "fontFamily": "$font-editorial",
                  "fontSize": 27,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "N0Vg92",
                  "name": "Answer",
                  "fill": "#6E655C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "No. You choose the repairer. Tell your carrier the vehicle is going to Trends and we handle the rest of that conversation.",
                  "lineHeight": 1.85,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "L3hLd",
              "name": "Q — How long will my car be ",
              "width": "fill_container",
              "stroke": "#05050626",
              "strokeWidth": {
                "top": 1
              },
              "gap": 56,
              "padding": [
                30,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "ett30",
                  "name": "Question",
                  "fill": "#141112",
                  "textGrowth": "fixed-width",
                  "width": 470,
                  "content": "How long will my car be here?",
                  "lineHeight": 1.25,
                  "fontFamily": "$font-editorial",
                  "fontSize": 27,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "s4C7tL",
                  "name": "Answer",
                  "fill": "#6E655C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "You get a date at estimate stage and an update at every change. Most claim repairs run seven to fourteen working days; heavy structural work runs longer and we say so early.",
                  "lineHeight": 1.85,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "LA0ls",
              "name": "Q — Will the paint match?",
              "width": "fill_container",
              "stroke": "#05050626",
              "strokeWidth": {
                "top": 1
              },
              "gap": 56,
              "padding": [
                30,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "B2UIwX",
                  "name": "Question",
                  "fill": "#141112",
                  "textGrowth": "fixed-width",
                  "width": 470,
                  "content": "Will the paint match?",
                  "lineHeight": 1.25,
                  "fontFamily": "$font-editorial",
                  "fontSize": 27,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "HvDLk",
                  "name": "Answer",
                  "fill": "#6E655C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Colour is mixed to the VIN code and then adjusted against your panel under shop light before anything is sprayed. We blend into adjacent panels so the repair doesn’t announce itself.",
                  "lineHeight": 1.85,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "ARqnu",
              "name": "Q — Can you recover the car ",
              "width": "fill_container",
              "stroke": "#05050626",
              "strokeWidth": {
                "top": 1
              },
              "gap": 56,
              "padding": [
                30,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "e1hKsk",
                  "name": "Question",
                  "fill": "#141112",
                  "textGrowth": "fixed-width",
                  "width": 470,
                  "content": "Can you recover the car tonight?",
                  "lineHeight": 1.25,
                  "fontFamily": "$font-editorial",
                  "fontSize": 27,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "roKyI",
                  "name": "Answer",
                  "fill": "#6E655C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Yes. Roadside dispatch runs around the clock — recovery, jump start, lockout and fuel — and the tow comes straight to our floor.",
                  "lineHeight": 1.85,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "EO4OF",
              "name": "Q — Is the work guaranteed?",
              "width": "fill_container",
              "stroke": "#05050626",
              "strokeWidth": {
                "top": 1
              },
              "gap": 56,
              "padding": [
                30,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "lU78A",
                  "name": "Question",
                  "fill": "#141112",
                  "textGrowth": "fixed-width",
                  "width": 470,
                  "content": "Is the work guaranteed?",
                  "lineHeight": 1.25,
                  "fontFamily": "$font-editorial",
                  "fontSize": 27,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "q3ljz",
                  "name": "Answer",
                  "fill": "#6E655C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Workmanship carries a lifetime warranty for as long as you own the vehicle, in writing, with the file we hand back.",
                  "lineHeight": 1.85,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
