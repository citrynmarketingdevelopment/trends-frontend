                  "letterSpacing": 1.4
                },
                {
                  "type": "text",
                  "id": "XY9VA",
                  "name": "Q",
                  "fill": "$bone",
                  "textGrowth": "fixed-width",
                  "width": 420,
                  "content": "Can I choose Trends for my repair?",
                  "lineHeight": 1.35,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "dz7Yg",
                  "name": "A",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Yes. In California the choice of repair facility is yours, regardless of which shop your insurer suggests first.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "qvsQp",
              "name": "Q3",
