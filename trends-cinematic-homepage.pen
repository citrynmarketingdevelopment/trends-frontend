                28,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "T8SQv",
                  "name": "Question",
                  "fill": "$bone",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Do I have to use the shop my insurer names?",
                  "lineHeight": 1.12,
                  "fontFamily": "$font-display",
                  "fontSize": 28,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "uumNJ",
                  "name": "Answer",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "No. The repairer is your choice. Give your carrier our details and we take the conversation from there.",
                  "lineHeight": 1.85,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "CcJci",
              "name": "Q",
              "width": "fill_container",
              "stroke": "#3B312A",
              "strokeWidth": {
                "top": 1
              },
              "layout": "vertical",
              "gap": 12,
              "padding": [
                26,
                0,
                28,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "tcx11",
                  "name": "Question",
                  "fill": "$bone",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "How long will the car be here?",
                  "lineHeight": 1.12,
                  "fontFamily": "$font-display",
                  "fontSize": 28,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "RDFKh",
                  "name": "Answer",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A date is quoted at teardown, once the hidden damage is visible — and you are told the moment it moves.",
                  "lineHeight": 1.85,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "dPegD",
