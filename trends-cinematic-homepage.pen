                {
                  "type": "text",
                  "id": "nPpq3",
                  "name": "H",
                  "fill": "$bone",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Nothing is decided from the outside.",
                  "lineHeight": 0.92,
                  "fontFamily": "$font-display",
                  "fontSize": 46,
                  "fontWeight": "800",
                  "letterSpacing": -1
                },
                {
                  "type": "frame",
                  "id": "oDXgC",
                  "name": "Sp3",
                  "width": "fill_container",
                  "height": 20
                },
                {
                  "type": "text",
                  "id": "KMrz1",
                  "name": "D",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The vehicle is received, photographed, and where the plan requires it, partially disassembled. Manufacturer repair procedures are pulled for the exact VIN before a single decision is made about what gets repaired and what gets replaced.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
