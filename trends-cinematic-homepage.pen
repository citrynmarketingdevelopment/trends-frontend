                  "fontFamily": "$font-mono",
                  "fontSize": 9,
                  "fontWeight": "600",
                  "letterSpacing": 1.4
                },
                {
                  "type": "text",
                  "id": "P3fTyA",
                  "name": "Q",
                  "fill": "$bone",
                  "textGrowth": "fixed-width",
                  "width": 420,
                  "content": "What is a supplement?",
                  "lineHeight": 1.35,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "w4ozX",
                  "name": "A",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A supplement documents damage that could not be seen at first inspection. It is submitted to your insurer for approval and you are told before work continues.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
