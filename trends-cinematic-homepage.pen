                  "type": "text",
                  "id": "QrukS",
                  "name": "D",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Structural measurement confirms what the impact actually moved. Panels are repaired or replaced to the published procedure, and the substrate is prepared so the refinish has something honest to sit on.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
